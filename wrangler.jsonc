{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "framy-connect-staging",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "framy-connect-staging",
      "database_id": "d53a1009-119e-41c2-9f05-db685dc9a0f4"
    }
  ],

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
